// REVIEW TEMPLATE ONLY. No deployment is authorized by this file.
// Copy to ignored local configuration only after the account, source SHA and deployment plan
// have been reviewed. New Worker owns new DO namespaces; never add production IDs/bindings.
{
  "name": "together-c1-acceptance",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {"name": "DIRECTORY", "class_name": "ConnectionDirectory"},
      {"name": "ROOMS", "class_name": "RelayRoom"}
    ]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ConnectionDirectory", "RelayRoom"]}],
  "vars": {"SERVICE_VERSION": "1", "MAX_FRAME_BYTES": "524288"},
  "observability": {"enabled": false}
}
