// Explicit opt-in only. Separate Worker and Durable Object namespaces.
// Never use this file to update the existing production together-connection Worker.
{
  "name": "together-pairing-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"DIRECTORY","class_name":"ConnectionDirectory"},{"name":"ROOMS","class_name":"RelayRoom"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ConnectionDirectory","RelayRoom"]}],
  "vars": {"SERVICE_VERSION":"2-partner-staging", "MAX_FRAME_BYTES":"524288"},
  "observability": {"enabled": false}
}
