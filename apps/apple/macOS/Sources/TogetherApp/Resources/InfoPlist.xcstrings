  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "Guidance; native microphone permission disclosure",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为伴侣录制爱意礼物。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a voice gift for your love."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Guidance; native local-network permission for authenticated device connections",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Together 与你的其他设备和伴侣的设备连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Together to connect to your devices and your partner’s devices."
          }
        }
      }
    }
  }
}
