    "device.guidance.controller": {
      "comment": "Guidance; user-requested device enrollment, migration and recovery controls",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用本人的原始可信设备授权或撤销设备。"
