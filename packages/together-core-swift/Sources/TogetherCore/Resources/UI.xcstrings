    "device.guidance.preserve": {
      "comment": "Guidance; user-requested device enrollment, migration and recovery controls",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原有资料保留在原存储，加入后使用新的副本。"
