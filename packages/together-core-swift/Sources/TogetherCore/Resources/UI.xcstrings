          "stringUnit": {
            "state": "translated",
            "value": "Import this file on your new device; it only adds your own device."
          }
        }
      }
    },
    "device.guidance.offerCheck": {
      "comment": "Guidance; user-requested device enrollment, migration and recovery controls",
