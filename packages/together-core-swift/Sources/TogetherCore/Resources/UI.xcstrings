    "device.guidance.migration": {
      "comment": "Guidance; user-requested device enrollment, migration and recovery controls",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先同步两台 Mac，再交换并核对迁移提案。"
          }
