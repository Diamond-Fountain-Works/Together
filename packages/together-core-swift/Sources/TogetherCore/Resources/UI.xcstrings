        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync both Macs, then exchange and verify the migration proposal."
          }
        }
      }
    },
    "device.guidance.checkMigration": {
      "comment": "Guidance; user-requested device enrollment, migration and recovery controls",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台 Mac 的安全码一致"
