        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both Macs show the same verification code"
          }
        }
      }
    },
    "device.guidance.offer": {
      "comment": "Guidance; user-requested device enrollment, migration and recovery controls",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新设备导入此文件，邀请仅用于添加本人设备。"
